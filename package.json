{
  "name": "line-by-line",
  "version": "0.1.0",
  "private": true,
  "description": "Extra work at an auto repair shop gets paid only line by line, the way the customer approved it in PayPal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "start": "node dist/server.js",
    "e2e:sandbox": "tsx scripts/e2e-sandbox.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
